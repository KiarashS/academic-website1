---
import type { Publication } from '../data/publications';
import { site } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  pub: Publication;
  index?: number;
  compact?: boolean;
}

const { pub, index, compact = false } = Astro.props;

const authors = pub.authors.map((raw) => {
  const equal = raw.endsWith('*');
  const name = equal ? raw.slice(0, -1) : raw;
  return { name, equal, isMe: name === site.name };
});

const hasEqual = authors.some((a) => a.equal);
---

<article class="pub" id={pub.id} data-reveal>
  <div class="idx label">{index !== undefined ? String(index).padStart(2, '0') : ''}</div>

  <div class="main">
    <div class="meta">
      <span class="pill">{pub.venue}</span>
      {pub.note && <span class="pill pill--accent">{pub.note}</span>}
      {pub.venueLong && <span class="venue-long faint">{pub.venueLong}</span>}
    </div>

    <h3 class="title">{pub.title}</h3>

    <p class="authors">
      {
        authors.map((a, i) => (
          <>
            {i > 0 && <span>, </span>}
            <span class:list={['author', { me: a.isMe }]}>
              {a.name}
              {a.equal && <span class="star">*</span>}
            </span>
          </>
        ))
      }
      {hasEqual && !compact && <span class="equal faint"> — equal contribution</span>}
    </p>
  </div>

  <div class="side">
    {!compact && pub.summary && <p class="summary">{pub.summary}</p>}

    <div class="actions">
      {
        (pub.links ?? []).map((link) => (
          <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
            {link.label}
            {link.href.startsWith('http') && <Icon name="external" size={11} />}
          </a>
        ))
      }
      {
        pub.bibtex && (
          <button type="button" class="bib-toggle" aria-expanded="false" data-bib={pub.id}>
            BibTeX
          </button>
        )
      }
    </div>

    {
      pub.bibtex && (
        <div class="bib" id={`bib-${pub.id}`} hidden>
          <pre><code>{pub.bibtex}</code></pre>
          <button type="button" class="copy" data-copy={pub.id}>
            <Icon name="copy" size={13} />
            <span>Copy</span>
          </button>
        </div>
      )
    }
  </div>

  <div class="year">{pub.year}</div>
</article>

<script>
  const wire = () => {
    document.querySelectorAll<HTMLButtonElement>('.bib-toggle').forEach((btn) => {
      if (btn.dataset.wired) return;
      btn.dataset.wired = 'true';
      btn.addEventListener('click', () => {
        const box = document.getElementById(`bib-${btn.dataset.bib}`);
        if (!box) return;
        const open = !box.hidden;
        box.hidden = open;
        btn.setAttribute('aria-expanded', String(!open));
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.copy').forEach((btn) => {
      if (btn.dataset.wired) return;
      btn.dataset.wired = 'true';
      btn.addEventListener('click', async () => {
        const text = btn.parentElement?.querySelector('code')?.textContent ?? '';
        try {
          await navigator.clipboard.writeText(text);
          const label = btn.querySelector('span');
          if (!label) return;
          label.textContent = 'Copied';
          setTimeout(() => (label.textContent = 'Copy'), 1600);
        } catch {
          /* clipboard blocked — the text is on screen anyway */
        }
      });
    });
  };
  wire();
  document.addEventListener('astro:page-load', wire);
</script>

<style>
  .pub {
    position: relative;
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1.08fr) minmax(0, 1fr) 4.5rem;
    gap: 1.5rem clamp(1.5rem, 3vw, 3rem);
    padding: clamp(1.75rem, 3vw, 2.5rem) 0;
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 7rem;
    transition: padding-left 0.35s var(--ease);
  }

  /* Accent rail that slides in from the left on hover. */
  .pub::before {
    content: '';
    position: absolute;
    left: -1.5rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.35s var(--ease);
  }

  .pub:hover::before,
  .pub:target::before {
    transform: scaleY(1);
  }

  .pub:hover {
    padding-left: 0.75rem;
  }

  .idx {
    padding-top: 0.5rem;
    color: var(--ink-faint);
    transition: color 0.3s var(--ease);
  }

  .pub:hover .idx {
    color: var(--accent);
  }

  .year {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-variation-settings: 'opsz' 20;
    letter-spacing: -0.02em;
    text-align: right;
    color: var(--ink-faint);
    transition: color 0.3s var(--ease);
  }

  .pub:hover .year {
    color: var(--ink);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.75rem;
    margin-bottom: 0.9rem;
  }

  .venue-long {
    font-size: 0.78rem;
  }

  .title {
    font-size: clamp(1.35rem, 2.4vw, 1.95rem);
    font-variation-settings: 'opsz' 28;
    line-height: 1.1;
    letter-spacing: -0.028em;
    transition: color 0.25s var(--ease);
  }

  .pub:hover .title {
    color: var(--accent);
  }

  .authors {
    margin-top: 0.85rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .author.me {
    color: var(--ink);
    font-weight: 600;
  }

  .star {
    color: var(--accent);
  }

  .equal {
    font-size: 0.8rem;
  }

  .side {
    padding-top: 0.4rem;
  }

  .summary {
    max-width: 46ch;
    font-size: 0.97rem;
    color: var(--ink-soft);
  }

  .actions {
    margin-top: 1.25rem;
  }

  .bib {
    position: relative;
    margin-top: 1rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--paper-sunk);
  }

  .bib pre {
    margin: 0;
    padding: 1rem 1.1rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .copy {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper);
    font-size: 0.7rem;
    color: var(--ink-soft);
  }

  .copy:hover {
    color: #fff;
    background: var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 64rem) {
    .pub {
      grid-template-columns: 3.25rem minmax(0, 1fr) 4.5rem;
    }

    .side {
      grid-column: 2;
      padding-top: 1.1rem;
    }
  }

  @media (max-width: 52rem) {
    .pub {
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: 0.6rem 1rem;
      padding-left: 0;
    }

    .pub:hover {
      padding-left: 0;
    }

    .pub::before {
      left: -0.75rem;
    }

    .year {
      grid-column: 1;
      grid-row: 1;
      text-align: left;
      font-size: 1.05rem;
      padding-top: 0.1rem;
    }

    .idx {
      display: none;
    }

    .main,
    .side {
      grid-column: 2;
    }

    .side {
      padding-top: 1rem;
    }
  }
</style>
