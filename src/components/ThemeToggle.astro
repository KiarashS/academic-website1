---
import Icon from './Icon.astro';
---

<button id="theme-toggle" type="button" aria-label="Switch colour theme" title="Switch colour theme">
  <span class="sun"><Icon name="sun" size={17} /></span>
  <span class="moon"><Icon name="moon" size={17} /></span>
</button>

<script>
  const wire = () => {
    const btn = document.getElementById('theme-toggle');
    if (!btn || btn.dataset.wired) return;
    btn.dataset.wired = 'true';
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
    });
  };
  wire();
  document.addEventListener('astro:page-load', wire);
</script>

<style>
  button {
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    color: var(--ink-soft);
    background: var(--paper-2);
    transition:
      color 0.15s var(--ease),
      border-color 0.15s var(--ease),
      background 0.15s var(--ease);
  }

  button:hover {
    color: var(--accent);
    border-color: var(--accent-edge);
    background: var(--accent-wash);
  }

  button > span {
    grid-area: 1 / 1;
    display: grid;
    transition:
      opacity 0.2s var(--ease),
      transform 0.25s var(--ease);
  }

  .moon {
    opacity: 0;
    transform: rotate(-40deg) scale(0.7);
  }

  :global(html[data-theme='dark']) .sun {
    opacity: 0;
    transform: rotate(40deg) scale(0.7);
  }

  :global(html[data-theme='dark']) .moon {
    opacity: 1;
    transform: none;
  }
</style>
