---
interface Props {
  items: string[];
  /** Seconds for one full pass. */
  speed?: number;
}

const { items, speed = 42 } = Astro.props;
const run = [...items, ...items];
---

<div class="marquee" aria-hidden="true" style={`--speed:${speed}s`}>
  <div class="track">
    {
      run.map((item) => (
        <span class="item">
          {item}
          <i class="sep">◆</i>
        </span>
      ))
    }
  </div>
</div>
<p class="sr-only">Published at {items.join(', ')}.</p>

<style>
  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .track {
    display: flex;
    width: max-content;
    animation: slide var(--speed) linear infinite;
  }

  .item {
    display: inline-flex;
    align-items: center;
    gap: 2.2rem;
    padding-right: 2.2rem;
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    font-variation-settings: 'opsz' 28;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--band-soft);
  }

  .sep {
    font-size: 0.4em;
    font-style: normal;
    color: var(--accent-on-band);
    transform: translateY(-0.15em);
  }

  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
