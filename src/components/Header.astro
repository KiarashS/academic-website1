---
import { nav, site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** Page opens on a dark band; the header floats over it until scrolled. */
  band?: boolean;
}

const { band = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const initials = site.name
  .split(' ')
  .map((w) => w[0])
  .join('');
---

<header class:list={['site-header', { 'on-band': band }]} data-band={band ? 'true' : undefined}>
  <div class="shell bar">
    <a class="brand" href="/">
      <span class="mark" aria-hidden="true">{initials}</span>
      <span class="brand-name">{site.name}</span>
    </a>

    <nav aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<script>
  const wire = () => {
    const header = document.querySelector<HTMLElement>('.site-header');
    if (!header) return;
    const hero = document.getElementById('hero');
    const onScroll = () => {
      const stuck = window.scrollY > 8;
      header.classList.toggle('is-stuck', stuck);
      if (header.dataset.band) {
        const past = hero ? window.scrollY > hero.offsetHeight - 90 : stuck;
        header.classList.toggle('on-band', !past);
      }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  };
  wire();
  document.addEventListener('astro:page-load', wire);
</script>

<style>
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 78%, transparent);
    backdrop-filter: saturate(1.5) blur(14px);
    -webkit-backdrop-filter: saturate(1.5) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      background 0.3s var(--ease),
      border-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .site-header.is-stuck {
    border-bottom-color: var(--rule);
  }

  /* Floating over the dark hero: no plate, light text. */
  .site-header.on-band {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
    color: var(--band-ink);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-right: auto;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: transform 0.35s var(--ease);
  }

  .brand:hover .mark {
    transform: rotate(90deg) scale(1.06);
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-variation-settings: 'opsz' 16;
    letter-spacing: -0.015em;
  }

  nav ul {
    display: flex;
    gap: 0.2rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  nav a {
    position: relative;
    display: block;
    padding: 0.45rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    white-space: nowrap;
    transition: color 0.2s var(--ease);
  }

  .on-band nav a {
    color: var(--band-soft);
  }

  /* Sliding underline instead of a pill. */
  nav a::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.15rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }

  nav a:hover {
    color: var(--ink);
  }

  .on-band nav a:hover {
    color: var(--band-ink);
  }

  nav a:hover::after {
    transform: scaleX(1);
  }

  nav a[aria-current='page'] {
    color: var(--accent);
  }

  .on-band nav a[aria-current='page'] {
    color: var(--accent-on-band);
  }

  nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  @media (max-width: 52rem) {
    .bar {
      flex-wrap: wrap;
      gap: 0.4rem 0.75rem;
      min-height: 0;
      padding-block: 0.75rem;
    }

    .brand-name {
      font-size: 1rem;
    }

    nav {
      order: 3;
      width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 1.5rem, #000 calc(100% - 1.5rem), transparent);
      mask-image: linear-gradient(90deg, transparent, #000 1.5rem, #000 calc(100% - 1.5rem), transparent);
    }

    nav::-webkit-scrollbar {
      display: none;
    }

    nav a {
      padding-inline: 0.55rem;
    }
  }
</style>
