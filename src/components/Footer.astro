---
import { nav, site } from '../data/site';
import ProfileLinks from './ProfileLinks.astro';
import AttentionGrid from './AttentionGrid.astro';
import { url } from '../lib/url';

const buildDate = new Date();
const updated = buildDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const year = buildDate.getFullYear();
---

<footer class="site-footer band">
  <div class="shell">
    <div class="grid">
      <div class="about">
        <p class="wordmark">{site.name}</p>
        <p class="muted small">{site.affiliation}</p>
        <p class="small">
          <a class="ul" href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <div class="mark">
          <AttentionGrid n={9} animate={false} />
        </div>
      </div>

      <nav aria-label="Footer">
        <p class="label">Pages</p>
        <ul>
          {nav.map((item) => <li><a class="ul" href={url(item.href)}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div>
        <p class="label">Elsewhere</p>
        <ProfileLinks variant="plain" />
      </div>
    </div>

    <div class="baseline">
      <p class="small faint">© {year} {site.name}. Built with Astro. Text under CC&nbsp;BY&nbsp;4.0.</p>
      <p class="small faint">Last updated {updated}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--band-2);
    border-top: 1px solid var(--band-rule);
    padding-block: clamp(3rem, 6vw, 5rem) 2.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr 1fr;
    gap: 3rem;
  }

  .wordmark {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-variation-settings: 'opsz' 28;
    letter-spacing: -0.03em;
    color: var(--band-ink);
    margin-bottom: 0.6rem;
  }

  .about p + p {
    margin-top: 0.3rem;
  }

  .mark {
    width: 6.5rem;
    margin-top: 2rem;
    color: var(--band-soft);
    opacity: 0.55;
  }

  nav ul,
  .grid ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: var(--t-small);
  }

  .grid a {
    color: var(--band-soft);
  }

  .label + :global(*) {
    margin-top: 1rem;
  }

  .baseline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--band-rule);
  }

  @media (max-width: 52rem) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.25rem 1.5rem;
    }

    .about {
      grid-column: 1 / -1;
    }

    .mark {
      display: none;
    }
  }
</style>
