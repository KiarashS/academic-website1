---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Set on the home page so the title is not "Home · Alex Rivera". */
  bareTitle?: boolean;
  /** The page opens on a dark full-bleed band, so the header starts light. */
  bandHeader?: boolean;
}

const {
  title,
  description = site.description,
  bareTitle = false,
  bandHeader = false,
} = Astro.props;

const pageTitle = !title
  ? `${site.name} — ${site.tagline}`
  : bareTitle
    ? title
    : `${title} · ${site.name}`;

// Astro.url.pathname already carries the base, so it joins straight onto the origin.
const origin = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL(url('/og.png'), origin).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.tagline,
  affiliation: { '@type': 'Organization', name: site.affiliation },
  email: `mailto:${site.email}`,
  url: new URL(url('/'), origin).href,
  knowsAbout: site.interests,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="author" content={site.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#16140f" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline set:html={JSON.stringify(personSchema)} type="application/ld+json" />

    <!-- Set the theme before first paint so there is no flash. -->
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        const apply = () => {
          const stored = localStorage.getItem('theme');
          const theme =
            stored ??
            (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        };
        apply();
        // View transitions swap <html>, so re-apply after each navigation.
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>

    <ClientRouter />
  </head>

  <body class={bandHeader ? 'has-band' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header band={bandHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Fade sections in as they arrive. Cheap, and it makes the page feel built.
      const reveal = () => {
        const nodes = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) {
          nodes.forEach((n) => n.classList.add('in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
        );
        nodes.forEach((n) => io.observe(n));
        // Failsafe: never leave anything hidden.
        setTimeout(() => nodes.forEach((n) => n.classList.add('in')), 3000);
      };
      reveal();
      document.addEventListener('astro:page-load', reveal);
    </script>
  </body>
</html>
