---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { projects } from '../data/projects';
---

<Base
  title="Projects"
  description="Open-source software and datasets released by Alex Rivera: rolling-cache, kestrel, quantbench, attention-atlas."
>
  <PageHeader
    eyebrow="Software & data"
    title="Projects"
    lede="Code that outlived the paper it came from. Everything here is on GitHub under a permissive licence, and everything here is something I still answer issues about."
  />

  <div class="shell">
    <ul class="grid">
      {
        projects.map((project) => (
          <li class="card">
            <div class="card-top">
              <h2 class="name mono">{project.name}</h2>
              <span class="pill">{project.role}</span>
            </div>

            <p class="blurb muted">{project.blurb}</p>

            {project.snippet && (
              <pre class="snippet"><code>{project.snippet}</code></pre>
            )}

            <ul class="tags">
              {project.tags.map((tag) => <li class="pill">{tag}</li>)}
            </ul>

            <div class="actions">
              {project.links.map((link) => (
                <a
                  href={link.href}
                  target={link.href.startsWith('http') ? '_blank' : undefined}
                  rel="noopener"
                >
                  {link.label}
                  {link.href.startsWith('http') && <Icon name="external" size={12} />}
                </a>
              ))}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .grid {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--paper-2);
    transition:
      border-color 0.2s var(--ease),
      transform 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }

  .card:hover {
    border-color: var(--rule-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 0.75rem;
    margin-bottom: 0.85rem;
  }

  /* Role labels run long; let them wrap rather than widen the card. */
  .card-top .pill {
    white-space: normal;
    text-align: right;
  }

  .name {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--accent);
  }

  .blurb {
    font-size: 0.92rem;
  }

  .snippet {
    max-width: 100%;
    margin-top: 1rem;
    padding: 0.75rem 0.85rem;
    border-radius: 8px;
    background: var(--paper-sunk);
    border: 1px solid var(--rule);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.73rem;
    line-height: 1.6;
    color: var(--ink-soft);
    white-space: pre;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 1.1rem 0 0;
  }

  .actions {
    margin-top: auto;
    padding-top: 1.25rem;
  }

  @media (max-width: 52rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
