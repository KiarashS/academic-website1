---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PublicationItem from '../components/PublicationItem.astro';
import Icon from '../components/Icon.astro';
import { publications, kindLabels, type PubKind } from '../data/publications';

const kinds = ['conference', 'journal', 'workshop', 'preprint'] as const;
const counts = Object.fromEntries(
  kinds.map((k) => [k, publications.filter((p) => p.kind === k).length]),
) as Record<PubKind, number>;
const available = kinds.filter((k) => counts[k] > 0);
---

<Base
  bandHeader
  title="Publications"
  description="Peer-reviewed papers, journal articles, workshop papers and preprints by Alex Rivera."
>
  <PageHeader
    eyebrow="Publications"
    title="Papers"
    lede="Peer-reviewed work first, then preprints and workshop papers. Every entry links to a PDF and, where one exists, to the code and data needed to reproduce it."
  >
    <div class="toolbar no-print">
      <div class="filters" role="group" aria-label="Filter by publication type">
        <button type="button" class="chip is-on" data-filter="all" aria-pressed="true">
          All <span class="count">{publications.length}</span>
        </button>
        {
          available.map((kind) => (
            <button type="button" class="chip" data-filter={kind} aria-pressed="false">
              {kindLabels[kind]} <span class="count">{counts[kind]}</span>
            </button>
          ))
        }
      </div>

      <a class="arrow-link" href="/publications.bib" download>
        Download all BibTeX
        <Icon name="arrow" size={15} />
      </a>
    </div>
  </PageHeader>

  <div class="shell">
    <div class="pub-list" id="pub-list">
      {
        publications.map((pub, i) => (
          <div class="pub-row" data-kind={pub.kind}>
            <PublicationItem pub={pub} index={i + 1} />
          </div>
        ))
      }
    </div>

    <p class="empty faint" hidden id="empty">Nothing in that category yet.</p>
  </div>
</Base>

<script>
  const wire = () => {
    const list = document.getElementById('pub-list');
    if (!list) return;
    const rows = Array.from(list.querySelectorAll<HTMLElement>('.pub-row'));
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
    const empty = document.getElementById('empty');

    const paint = (filter: string) => {
      rows.forEach((row) => {
        row.hidden = filter !== 'all' && row.dataset.kind !== filter;
      });
      const visible = rows.filter((r) => !r.hidden);
      if (empty) empty.hidden = visible.length > 0;
    };

    chips.forEach((chip) => {
      if (chip.dataset.wired) return;
      chip.dataset.wired = 'true';
      chip.addEventListener('click', () => {
        chips.forEach((c) => {
          const on = c === chip;
          c.classList.toggle('is-on', on);
          c.setAttribute('aria-pressed', String(on));
        });
        paint(chip.dataset.filter ?? 'all');
      });
    });

    paint('all');
  };
  wire();
  document.addEventListener('astro:page-load', wire);
</script>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--band-rule);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--band-rule);
    border-radius: 999px;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--band-soft);
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      background 0.2s var(--ease);
  }

  .chip:hover {
    border-color: var(--band-ink);
    color: var(--band-ink);
  }

  .chip.is-on {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .count {
    font-size: 0.72rem;
    opacity: 0.6;
  }

  .toolbar :global(.arrow-link) {
    color: var(--band-soft);
  }

  .toolbar :global(.arrow-link:hover) {
    color: var(--accent-on-band);
  }

  .pub-list {
    padding-block: clamp(2rem, 5vw, 4rem) 2rem;
  }

  .pub-row[hidden] {
    display: none;
  }

  .empty {
    padding-block: 3rem 5rem;
    font-size: 0.9rem;
  }
</style>
