---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found">
  <div class="shell wrap">
    <p class="label label--accent">404</p>
    <h1>That page moved, or never existed</h1>
    <p class="lede">
      Papers keep their URLs, so an old link to one should still work. Everything else is one
      click away.
    </p>
    <a class="arrow-link" href="/">
      Back to the home page
      <Icon name="arrow" size={15} />
    </a>
  </div>
</Base>

<style>
  .wrap {
    padding-block: clamp(4rem, 14vw, 9rem);
    max-width: 44rem;
  }

  h1 {
    margin-top: 0.7rem;
  }

  .lede {
    margin-block: 1.2rem 2rem;
  }
</style>
