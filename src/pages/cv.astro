---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { education, experience, awards, service, skills, type Entry } from '../data/cv';
import { publications, kindLabels, type PubKind } from '../data/publications';
import { teaching } from '../data/teaching';

const order: PubKind[] = ['journal', 'conference', 'preprint', 'workshop', 'thesis'];
const grouped = order
  .map((kind) => ({ kind, items: publications.filter((p) => p.kind === kind) }))
  .filter((g) => g.items.length > 0);

const authorLine = (authors: string[]) => authors.join(', ');
---

<Base
  title="Curriculum vitae"
  description={`Curriculum vitae of ${site.name}: education, research experience, publications, teaching, awards and academic service.`}
>
  <div class="shell cv">
    <header class="cv-head">
      <div>
        <h1>{site.name}</h1>
        <p class="muted">{site.tagline} · {site.institution}</p>
        <p class="contact mono faint">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <span aria-hidden="true">·</span>
          <span>{site.location}</span>
          <span aria-hidden="true">·</span>
          <a href={site.url}>{site.url.replace('https://', '')}</a>
        </p>
      </div>

      <div class="cv-actions no-print">
        <a class="button" href={site.cvPdf} download>
          <Icon name="file" size={15} />
          PDF
        </a>
        <button class="button" type="button" id="print-cv">
          Print
        </button>
      </div>
    </header>

    <section class="section">
      <h2>Education</h2>
      <ul class="entries">
        {
          education.map((entry: Entry) => (
            <li>
              <span class="period mono">{entry.period}</span>
              <div>
                <p class="entry-title">{entry.title}</p>
                <p class="muted org">
                  {entry.org}
                  {entry.location && <span class="faint"> — {entry.location}</span>}
                </p>
                {entry.detail?.map((line) => <p class="muted line">{line}</p>)}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section">
      <h2>Research experience</h2>
      <ul class="entries">
        {
          experience.map((entry: Entry) => (
            <li>
              <span class="period mono">{entry.period}</span>
              <div>
                <p class="entry-title">{entry.title}</p>
                <p class="muted org">
                  {entry.org}
                  {entry.location && <span class="faint"> — {entry.location}</span>}
                </p>
                {entry.detail?.map((line) => <p class="muted line">{line}</p>)}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section">
      <h2>Publications</h2>
      <p class="muted note">
        Authors are listed in contribution order; * marks equal contribution. The same list
        with PDFs, code and BibTeX is on the{' '}
        <a href="/publications/">publications page</a>.
      </p>
      {
        grouped.map((group) => (
          <div class="pub-group">
            <h3 class="eyebrow">{kindLabels[group.kind]}</h3>
            <ol class="pubs">
              {group.items.map((pub) => (
                <li>
                  <span class="pub-authors">{authorLine(pub.authors)}</span>.
                  <span class="pub-title"> {pub.title}</span>.
                  <span class="muted"> {pub.venueLong ?? pub.venue}, {pub.year}.</span>
                  {pub.note && <span class="pub-note"> {pub.note}.</span>}
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </section>

    <section class="section">
      <h2>Teaching</h2>
      <ul class="entries">
        {
          teaching.map((course) => (
            <li>
              <span class="period mono">{course.term}</span>
              <div>
                <p class="entry-title">
                  {course.code !== '—' && <span class="mono code">{course.code}</span>}
                  {course.title}
                </p>
                <p class="muted org">{course.role}, {course.institution}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section">
      <h2>Awards</h2>
      <ul class="entries tight">
        {
          awards.map((award) => (
            <li>
              <span class="period mono">{award.period}</span>
              <div>
                <p class="entry-title">{award.title}</p>
                <p class="muted org">{award.org}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section">
      <h2>Service</h2>
      <div class="service">
        <div>
          <h3 class="eyebrow">Reviewing</h3>
          <ul class="plain">{service.reviewing.map((s) => <li>{s}</li>)}</ul>
        </div>
        <div>
          <h3 class="eyebrow">Organising</h3>
          <ul class="plain">{service.organising.map((s) => <li>{s}</li>)}</ul>
        </div>
        <div>
          <h3 class="eyebrow">Outreach</h3>
          <ul class="plain">{service.outreach.map((s) => <li>{s}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>Technical</h2>
      <ul class="entries tight">
        {
          skills.map((row) => (
            <li>
              <span class="period">{row.group}</span>
              <div><p class="muted">{row.items}</p></div>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<script>
  const wire = () => {
    const btn = document.getElementById('print-cv');
    if (!btn || btn.dataset.wired) return;
    btn.dataset.wired = 'true';
    btn.addEventListener('click', () => window.print());
  };
  wire();
  document.addEventListener('astro:page-load', wire);
</script>

<style>
  .cv {
    padding-top: clamp(2.5rem, 6vw, 4rem);
  }

  .cv-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-bottom: 1.75rem;
  }

  h1 {
    font-size: clamp(2.1rem, 5vw, 3rem);
    font-variation-settings: 'opsz' 36;
    letter-spacing: -0.025em;
  }

  .cv-head > div > p {
    margin-top: 0.4rem;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.8rem;
  }

  .contact a {
    color: inherit;
    text-decoration: none;
  }

  .contact a:hover {
    color: var(--accent);
  }

  .cv-actions {
    display: flex;
    gap: 0.5rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: var(--paper-2);
    font-size: 0.83rem;
    color: var(--ink-soft);
    text-decoration: none;
    transition:
      color 0.15s var(--ease),
      border-color 0.15s var(--ease),
      background 0.15s var(--ease);
  }

  .button:hover {
    color: var(--accent);
    border-color: var(--accent-edge);
    background: var(--accent-wash);
  }

  .section {
    padding-block: 1.75rem;
  }

  .section h2 {
    font-size: 0.78rem;
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    padding-bottom: 0.6rem;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--rule);
  }

  .entries {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .entries.tight {
    gap: 0.6rem;
  }

  .entries li {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1.25rem;
  }

  .period {
    font-size: 0.78rem;
    color: var(--ink-faint);
    padding-top: 0.15rem;
  }

  .entry-title {
    font-weight: 550;
    font-size: 0.95rem;
  }

  .code {
    color: var(--accent);
    font-size: 0.8rem;
    margin-right: 0.45rem;
  }

  .org,
  .line {
    font-size: 0.9rem;
    margin-top: 0.15rem;
  }

  .note {
    font-size: 0.87rem;
    max-width: 62ch;
    margin-bottom: 1.4rem;
  }

  .pub-group + .pub-group {
    margin-top: 1.5rem;
  }

  .pubs {
    margin: 0.6rem 0 0;
    padding-left: 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.9rem;
  }

  .pubs li::marker {
    color: var(--ink-faint);
    font-size: 0.8em;
  }

  .pub-title {
    font-style: italic;
  }

  .pub-note {
    color: var(--accent);
    font-weight: 550;
  }

  .service {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .plain {
    list-style: none;
    padding: 0;
    margin: 0.7rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  @media (max-width: 46rem) {
    .entries li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .service {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
