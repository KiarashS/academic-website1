---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { talks } from '../data/talks';

const kindLabel: Record<string, string> = {
  invited: 'Invited',
  conference: 'Conference',
  poster: 'Poster',
  seminar: 'Seminar',
};

const byYear = talks.reduce<Record<string, typeof talks>>((acc, talk) => {
  const year = talk.date.slice(0, 4);
  (acc[year] ??= []).push(talk);
  return acc;
}, {});

const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });
---

<Base
  title="Talks"
  description="Conference talks, invited seminars and posters given by Alex Rivera."
>
  <PageHeader
    eyebrow="Talks & posters"
    title="Talks"
    lede="Slides are usually up within a day of the talk. If a link is missing and you want the deck, email me."
  />

  <div class="shell">
    {
      years.map((year) => (
        <section class="year-block">
          <h2 class="year">{year}</h2>
          <ul>
            {byYear[year]!.map((talk) => (
              <li>
                <div class="when">
                  <time class="mono" datetime={talk.date}>{fmt(talk.date)}</time>
                </div>
                <div>
                  <div class="head">
                    <h3>{talk.title}</h3>
                    <span class="pill">{kindLabel[talk.kind]}</span>
                  </div>
                  <p class="muted where">
                    {talk.event}
                    <span class="dot-sep" aria-hidden="true">·</span>
                    <span class="loc">
                      <Icon name="pin" size={13} />
                      {talk.location}
                    </span>
                  </p>
                  {talk.links && (
                    <div class="actions">
                      {talk.links.map((link) => (
                        <a href={link.href}>{link.label}</a>
                      ))}
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .year-block {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1.5rem;
    padding-block: 2.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .year-block:last-child {
    border-bottom: none;
  }

  .year {
    font-size: 1.35rem;
    font-variation-settings: 'opsz' 20;
    color: var(--ink-faint);
    position: sticky;
    top: 5.5rem;
    align-self: start;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
  }

  .when time {
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  .head {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  h3 {
    font-size: 1.1rem;
    font-variation-settings: 'opsz' 18;
  }

  .where {
    margin-top: 0.35rem;
    font-size: 0.875rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .loc {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--ink-faint);
  }

  .dot-sep {
    color: var(--ink-faint);
  }

  .actions {
    margin-top: 0.6rem;
  }

  @media (max-width: 44rem) {
    .year-block {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .year {
      position: static;
    }

    li {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>
