---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { talks } from '../data/talks';
import { url } from '../lib/url';

const kindLabel: Record<string, string> = {
  invited: 'Invited',
  conference: 'Conference',
  poster: 'Poster',
  seminar: 'Seminar',
};

const byYear = talks.reduce<Record<string, typeof talks>>((acc, talk) => {
  const year = talk.date.slice(0, 4);
  (acc[year] ??= []).push(talk);
  return acc;
}, {});

const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });
---

<Base
  bandHeader
  title="Talks"
  description="Conference talks, invited seminars and posters given by Alex Rivera."
>
  <PageHeader
    eyebrow="Talks & posters"
    title="Talks"
    lede="Slides are usually up within a day of the talk. If a link is missing and you want the deck, email me."
    meta={`${talks.length} talks since 2024`}
  />

  <div class="shell">
    {
      years.map((year) => (
        <section class="year-block">
          <h2 class="year">{year}</h2>
          <ul>
            {byYear[year]!.map((talk) => (
              <li data-reveal>
                <div class="when">
                  <time class="label" datetime={talk.date}>{fmt(talk.date)}</time>
                </div>
                <div class="talk-main">
                  <h3>{talk.title}</h3>
                  <p class="muted where">
                    {talk.event}
                    <span class="dot-sep" aria-hidden="true">/</span>
                    <span class="loc">
                      <Icon name="pin" size={13} />
                      {talk.location}
                    </span>
                  </p>
                </div>

                <div class="talk-side">
                  <span class="pill">{kindLabel[talk.kind]}</span>
                  {talk.links && (
                    <div class="actions">
                      {talk.links.map((link) => (
                        <a href={url(link.href)}>{link.label}</a>
                      ))}
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .year-block {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    padding-block: clamp(2.5rem, 4vw, 4rem);
    border-top: 1px solid var(--rule);
  }

  .year-block:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .year {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-variation-settings: 'opsz' 36;
    letter-spacing: -0.04em;
    color: var(--accent);
    opacity: 0.35;
    position: sticky;
    top: 7rem;
    align-self: start;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: 1rem clamp(1.25rem, 2.5vw, 2.5rem);
    padding-block: 1.5rem;
    border-bottom: 1px dashed var(--rule);
  }

  li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  li:first-child {
    padding-top: 0;
  }

  .when time {
    display: block;
    padding-top: 0.5rem;
    color: var(--ink-faint);
  }

  h3 {
    font-size: clamp(1.2rem, 2.1vw, 1.6rem);
    max-width: 24ch;
  }

  .where {
    margin-top: 0.55rem;
    font-size: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .loc {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--ink-faint);
  }

  .dot-sep {
    color: var(--accent);
  }

  .talk-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    padding-top: 0.35rem;
  }

  @media (max-width: 62rem) {
    li {
      grid-template-columns: 5rem minmax(0, 1fr);
    }

    .talk-side {
      grid-column: 2;
    }
  }

  @media (max-width: 44rem) {
    .year-block {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .year {
      position: static;
    }

    li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.4rem;
    }

    .talk-side {
      grid-column: 1;
    }

    .when time {
      padding-top: 0;
    }
  }
</style>
